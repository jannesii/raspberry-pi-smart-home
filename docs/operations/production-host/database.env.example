# Copy to ~/.config/jannenkoti-ops/database.env (mode 600) for scripts/db_query.py.
# Production: the read-only role only, addressed as seen from the Pi; the
# command reaches it through an SSH tunnel to PRODUCTION_SSH_HOST.
PRODUCTION_DATABASE_URL=postgresql://jannenkoti_readonly:CHANGE_ME@127.0.0.1:5432/jannenkoti
PRODUCTION_SSH_HOST=raspi
# Development: a separate local database; writes are committed.
DEVELOPMENT_DATABASE_URL=postgresql://jannenkoti_dev:CHANGE_ME@127.0.0.1:5432/jannenkoti_dev
