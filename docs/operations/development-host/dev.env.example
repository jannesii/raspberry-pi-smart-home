# Copy to ~/.config/jannenkoti-dev/dev.env (mode 600). Set new development values.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://jannenkoti_dev:CHANGE_ME@127.0.0.1:5432/jannenkoti_dev
# The lifecycle starts its own Redis with persistence off.
REDIS_URL=redis://127.0.0.1:6380/0
DEV_STATE_DIR=/home/jannesi/.local/state/jannenkoti-dev
DB_PATH=/home/jannesi/.local/state/jannenkoti-dev/legacy.db
VILLENKOTI_DB_PATH=/home/jannesi/.local/state/jannenkoti-dev/villenkoti.db
SECRET_KEY=CHANGE_ME
WEB_USERNAME=dev-tester
WEB_PASSWORD=CHANGE_ME
DEV_BIND_HOST=192.168.1.100
PORT=5557
DEV_TLS_CERT=/home/jannesi/.config/jannenkoti-dev/server.pem
DEV_TLS_KEY=/home/jannesi/.config/jannenkoti-dev/server.key
DEV_TLS_CA=/home/jannesi/.config/jannenkoti-dev/ca.pem
