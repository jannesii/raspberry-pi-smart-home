# Development environment file: copy to ~/.config/jannenkoti-dev/dev.env
# (chmod 600) and replace every CHANGE_ME. Never reuse production values.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://jannenkoti_dev:CHANGE_ME@127.0.0.1:5432/jannenkoti_dev
USE_SQLA_READS=1
# scripts/dev.py start runs this Redis itself (no persistence); keep the port free.
REDIS_URL=redis://127.0.0.1:6380/0
DEV_STATE_DIR=/home/jannesi/.local/state/jannenkoti-dev
DB_PATH=/home/jannesi/.local/state/jannenkoti-dev/legacy.db
VILLENKOTI_DB_PATH=/home/jannesi/.local/state/jannenkoti-dev/villenkoti.db
SECRET_KEY=CHANGE_ME
WEB_USERNAME=dev-tester
WEB_PASSWORD=CHANGE_ME
# The Cloudflare Tunnel routes https://dev.jannenkoti.com to this port.
PORT=5557
